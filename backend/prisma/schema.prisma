generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum QueueRetryStrategy {
  FIXED
  LINEAR
  EXPONENTIAL
}

enum JobType {
  IMMEDIATE
  SCHEDULED
  RECURRING
  BATCH
}

enum JobStatus {
  QUEUED
  SCHEDULED
  DEPENDENCY_WAITING
  CLAIMED
  RUNNING
  COMPLETED
  FAILED
  DLQ
}

enum WorkerStatus {
  ACTIVE
  INACTIVE
  DEAD
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  organizations OrganizationUser[]
}

model Organization {
  id        String             @id @default(uuid())
  name      String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  users     OrganizationUser[]
  projects  Project[]
}

model OrganizationUser {
  organizationId String
  userId         String
  role           Role         @default(USER)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
}

model Project {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  queues         Queue[]
}

model Queue {
  id                 String             @id @default(uuid())
  projectId          String
  name               String
  priority           Int                @default(0)
  concurrencyLimit   Int                @default(10)
  maxRetries         Int                @default(3)
  retryStrategy      QueueRetryStrategy @default(EXPONENTIAL)
  isPaused           Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobs               Job[]

  @@unique([projectId, name])
}

model Job {
  id            String        @id @default(uuid())
  queueId       String
  type          JobType       @default(IMMEDIATE)
  payload       Json
  status        JobStatus     @default(QUEUED)
  priority      Int           @default(0)
  runAt         DateTime      @default(now())
  attempts      Int           @default(0)
  cron          String?
  batchId       String?
  shardKey      Int           @default(1)
  parentJobId   String?
  parentJob     Job?          @relation("JobDependencies", fields: [parentJobId], references: [id], onDelete: SetNull)
  childJobs     Job[]         @relation("JobDependencies")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  queue         Queue         @relation(fields: [queueId], references: [id], onDelete: Cascade)
  executions    JobExecution[]

  @@index([status, runAt, priority])
}

model JobExecution {
  id           String    @id @default(uuid())
  jobId        String
  workerId     String
  status       JobStatus
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  errorMessage String?
  job          Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker       Worker    @relation(fields: [workerId], references: [id], onDelete: SetNull)
  logs         JobLog[]
}

model JobLog {
  id             String       @id @default(uuid())
  jobExecutionId String
  message        String
  timestamp      DateTime     @default(now())
  jobExecution   JobExecution @relation(fields: [jobExecutionId], references: [id], onDelete: Cascade)
}

model Worker {
  id            String         @id @default(uuid())
  status        WorkerStatus   @default(ACTIVE)
  lastHeartbeat DateTime       @default(now())
  executions    JobExecution[]
}
